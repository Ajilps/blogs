MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=ajil_blog
ADMIN_EMAIL=iamajil.tech@gmail.com
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-random-32-byte-secret

# New Vercel Blob stores use VERCEL_OIDC_TOKEN automatically on Vercel.
# Existing token-based stores can use BLOB_READ_WRITE_TOKEN instead.
VERCEL_OIDC_TOKEN=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=